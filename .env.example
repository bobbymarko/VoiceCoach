# Zwift AI Coach Configuration
# Copy this file to .env and fill in your API keys

# Required: Anthropic API key for Claude AI coaching commentary
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required: ElevenLabs API key for text-to-speech (omit for text-only mode)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: ElevenLabs voice ID (default: Sarah)
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Optional: Sauce for Zwift WebSocket URL (default shown)
# SAUCE_WS_URL=ws://localhost:1080/api/ws/events

# Optional: Sauce for Zwift HTTP API URL (default shown)
# SAUCE_HTTP_URL=http://localhost:1080/api
